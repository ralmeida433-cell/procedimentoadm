# Copie este arquivo para ".env" (mesma pasta) e cole sua chave da API do
# OpenRouter (gratuita, sem cartão) obtida em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Opcional: troca o modelo usado na consulta (padrão: nvidia/nemotron-3-ultra-550b-a55b:free)
# Veja outros modelos gratuitos em https://openrouter.ai/models?max_price=0
# MAPPA_MODELO=nvidia/nemotron-3-ultra-550b-a55b:free
